{{
    // pre request scripts
    const date = new Date()
    exports.startDate = date.toString()
    exports.endDate = date.toString()
}}

###
GET http://localhost:3000/posts
    ?startDate={{startDate}}
    &endDate={{endDate}}
    &limit=1
    &page=3

###
POST http://localhost:3000/posts
Content-Type: application/json

{
    "title": "myname",
    "postType": "post",
    "slug": "02",
    "status": "draft",
    "content": "hello",
    "schema": "hi",
    "publishOn": "2025-12-11",
    "tags": ["hi"],
    "metaOptions": [{"what": 2}]   
}

###
POST http://localhost:3000/posts
Content-Type: application/json

{
    "title": "What's new with NestJS",
    "postType": "post",
    "slug": "new-with-nestjs-6",
    "status": "draft",
    "content": "test content",
    "schema": "{\r\n    \"@context\": \"https:\/\/schema.org\",\r\n    \"@type\": \"Person\"\r\n  }",
    "featuredImageUrl": "http://localhost.com/images/image1.jpg",
    "publishOn": "2024-03-16T10:30:00",
    "tags": ["nestjs", "typescript"],
    "metaOptions": {
        "metaValue": { "sideBarEnabled": true, "footerActive": true }
    },
    "authorId": 1,
    "tags": [1,2]
}

###
PATCH http://localhost:3000/posts
Content-Type: application/json

{
    "id": 13,
    "title": "what's new with nestjs",
    "postType": "post",
    "status": "draft",
    "content": "test content",
    "metaOptions": {
        "metaValue": { "sideBarEnabled": true, "footerActive": false }
    },
    "tags": [1,3]
}

###
DELETE http://localhost:3000/posts?id=10